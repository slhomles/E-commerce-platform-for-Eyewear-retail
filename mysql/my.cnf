[mysqld]
# Charset & collation: utf8mb4 để hỗ trợ Tiếng Việt + emoji
character-set-server = utf8mb4
collation-server     = utf8mb4_unicode_ci
init-connect         = 'SET NAMES utf8mb4'

# Timezone Việt Nam
default-time-zone    = '+07:00'

# Cho phép connection từ container khác
bind-address         = 0.0.0.0

# Tăng max connections (default 151 hơi thấp cho prod)
max_connections      = 200

# InnoDB tuning nhẹ
innodb_buffer_pool_size = 256M

# Cho phép password native (compat với Spring Boot JDBC)
default-authentication-plugin = mysql_native_password

[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4
