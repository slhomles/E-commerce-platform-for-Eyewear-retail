# Copy file này thành .env và điền giá trị thật
# Firebase config (lấy từ Firebase Console)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DB_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MSG_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Public URL used for OAuth redirects and email links.
# Production example: http://52.68.124.230 or https://your-domain.com
PUBLIC_APP_URL=
FRONTEND_URL=
BACKEND_URL=
CORS_ALLOWED_ORIGINS=

# Optional. Leave empty in Docker/Nginx production to use same-origin proxy.
VITE_BACKEND_URL=

# OAuth2 Credentials (Google, Facebook, GitHub)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
